#!/usr/bin/env bash

shopt -s globstar dotglob nullglob

function help {
	local command_name

	command_name="$(basename "$0")"
	echo "${command_name} - recursively synchronizes the default branch for one or more git repositories"
	echo -e "\nUsage: ${command_name} [<directory-path>...]"
	echo -e "\nOptions:"
	echo -e "\t-h, --help\tprints help"
	echo -e "\t-v, --version\tprints version"
	echo -e "\t--\t\ttreats the remaining arguments as directory paths, not options"
	echo -e "\nEvery <directory-path> is scanned recursively; when none is given, the current working directory is used."
	exit 0
}

function version {
	local command_name
	local version

	command_name="$(basename "$0")"
	version="1.7.0"

	echo "${command_name} - ${version}"
	exit 0
}

# Resolve the default branch without assuming that the remote is named "origin".
function get_default_branch_name {
	local remote
	local remote_head

	remote="${1}"
	remote_head=$(git symbolic-ref -q --short "refs/remotes/${remote}/HEAD") && {
		printf '%s\n' "${remote_head#"${remote}/"}"
		return
	}

	git ls-remote --symref "${remote}" HEAD 2>/dev/null |
		awk '$1 == "ref:" && $2 ~ /^refs\/heads\// { sub(/^refs\/heads\//, "", $2); print $2; exit }'
}

function is_repo_dirty {
	[[ $(git status -s | wc -l) -gt 0 ]]
}

function get_total_remotes {
	git remote 2>/dev/null | wc -l
}

function has_exactly_1_remote {
	local total_remotes

	total_remotes=$(get_total_remotes)
	[[ "${total_remotes}" -eq 1 ]]
}

# Puts the repository back on its original branch, or back on its original
# commit when it was in a detached HEAD state.
function restore_checkout {
	local original_branch
	local original_commit

	original_branch="${1}"
	original_commit="${2}"

	if [[ -n "${original_branch}" ]] && git switch "${original_branch}" &>/dev/null; then
		return 0
	fi

	if git switch --detach "${original_commit}" &>/dev/null; then
		return 0
	fi

	return 1
}

# Returns 0 when the repository was updated, 1 when it was already up to date
# and 2 when the synchronization failed.
function sync {
	local default_branch
	local hash_after_sync
	local hash_before_sync
	local original_branch
	local original_commit
	local pull_output
	local remote
	local restore_command
	local sync_status=1

	remote="${1}"
	default_branch="${2}"
	original_branch=$(git symbolic-ref --short -q HEAD)
	original_commit=$(git rev-parse HEAD)

	if ! git switch "${default_branch}" &>/dev/null; then # usually, master or main
		printf "error: could not switch to '%s' branch.\n" "${default_branch}" >&2
		return 2
	fi

	# Restore the original checkout even if this subshell is interrupted.
	printf -v restore_command 'restore_checkout %q %q' "${original_branch}" "${original_commit}"
	trap "${restore_command}" EXIT
	trap 'exit 2' HUP INT TERM

	hash_before_sync=$(git rev-parse HEAD)

	if pull_output=$(git pull "${remote}" "${default_branch}" 2>&1); then
		hash_after_sync=$(git rev-parse HEAD)
		if [[ "${hash_before_sync}" != "${hash_after_sync}" ]]; then
			sync_status=0
		fi
	else
		printf '%s\n' "${pull_output}" >&2
		sync_status=2
	fi

	if ! restore_checkout "${original_branch}" "${original_commit}"; then
		echo "error: could not restore the original checkout." >&2
		sync_status=2
	fi

	return "${sync_status}"
}

# Per-repository status codes, also written to the '.status' files used to
# build the final summary: 0 = updated, 1 = no changes, 2 = failed, 3 = skipped.
function sync_repository {
	local branch
	local project
	local remote
	local repository
	local status
	local status_file

	repository="${1}"
	status_file="${2}"
	project=$(dirname "${repository}")

	if ! cd "${project}"; then
		echo -e "${RED}error: skipping '${project}' - could not enter the directory.${NOCOLOR}" >&2
		status=3
	elif ! has_exactly_1_remote; then
		echo -e "${RED}error: skipping '${project}' - must have exactly 1 remote configured, but $(get_total_remotes) found.${NOCOLOR}" >&2
		status=3
	elif is_repo_dirty; then
		echo -e "${RED}error: skipping '${project}' because it is dirty.${NOCOLOR}" >&2
		status=3
	else
		remote=$(git remote)
		branch=$(get_default_branch_name "${remote}")
		if [[ -z "${branch}" ]]; then
			echo -e "${RED}error: skipping '${project}' - could not determine the default branch for remote '${remote}'.${NOCOLOR}" >&2
			status=3
		else
			echo -n "syncing '${project}' ('${branch}' branch)... "
			sync "${remote}" "${branch}" > /dev/null
			status=$?
			case "${status}" in
				0)
					echo -e "${BLUE}done!${NOCOLOR} ${GREEN}(updated)${NOCOLOR}"
					;;
				1)
					echo -e "${BLUE}done!${NOCOLOR} ${ORANGE}(no changes)${NOCOLOR}"
					;;
				*)
					status=2
					echo -e "${RED}failed.${NOCOLOR}" >&2
					;;
			esac
		fi
	fi

	printf '%s\n' "${status}" > "${status_file}"

	if [[ "${status}" -ge 2 ]]; then
		return 1
	fi
}

function wait_for_repository {
	local completed_pid
	local position
	wait -n -p completed_pid "${active_pids[@]}"

	for position in "${!active_pids[@]}"; do
		if [[ "${active_pids[${position}]}" == "${completed_pid}" ]]; then
			unset 'active_pids[position]'
			break
		fi
	done

	completed_syncs=$((completed_syncs + 1))
	show_progress
}

function show_progress {
	local bar_width=30
	local completed_bar
	local completed_width
	local percentage
	local remaining_bar
	local remaining_width

	[[ -t 1 ]] || return

	percentage=$((completed_syncs * 100 / total_syncs))
	completed_width=$((completed_syncs * bar_width / total_syncs))
	remaining_width=$((bar_width - completed_width))
	printf -v completed_bar '%*s' "${completed_width}" ''
	printf -v remaining_bar '%*s' "${remaining_width}" ''
	completed_bar=${completed_bar// /#}
	remaining_bar=${remaining_bar// /-}
	printf '\rSync progress: [%s] %d/%d (%d%%)' \
		"${completed_bar}${remaining_bar}" \
		"${completed_syncs}" "${total_syncs}" "${percentage}"
}

end_of_options=no
paths=()

for argument in "$@"; do
	if [[ "${end_of_options}" == no && "${argument}" == -- ]]; then
		end_of_options=yes
	elif [[ "${end_of_options}" == no && "${argument}" == -* ]]; then
		case "${argument}" in
			-h|--help) help ;;
			-v|--version) version ;;
			*)
				echo "error: unknown option '${argument}'." >&2
				echo "run '$(basename "$0") --help' for usage information." >&2
				exit 1
				;;
		esac
	else
		paths+=("${argument}")
	fi
done

if [[ "${#paths[@]}" -eq 0 ]]; then
	paths=(".") # uses the current working directory by default when no argument is given
fi

############ colors ################
RED='\033[0;31m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
NOCOLOR='\033[0m'
####################################

directories=()
declare -A requested_directories=()

for path in "${paths[@]}"; do
	if [[ ! -d "${path}" || ! -r "${path}" ]]; then
		echo -e "${RED}error: '${path}' not found or is unreadable or is not a directory.${NOCOLOR}" >&2
		exit 1
	fi

	resolved_path="$(realpath -- "${path}")" || {
		echo -e "${RED}error: could not resolve the path to '${path}'.${NOCOLOR}" >&2
		exit 1
	}
	path="${resolved_path}"

	if [[ -n "${requested_directories[${path}]:-}" ]]; then
		continue # repeated identical paths are silently treated as if given only once
	fi
	requested_directories["${path}"]=yes
	directories+=("${path}")
done

# Accumulate the repositories of every given directory, in the order the
# directories were given, deduplicating repositories shared between paths
# (e.g. due to nested or symlinked paths) so each one syncs only once.
declare -a repositories=()
declare -A included_repositories=() # maps a repository (canonicalized) to the directory path that first included it
declare -a empty_paths=()
printed_warnings=no

# Warns that a single repository was already claimed by an earlier scanned
# directory path.
function warn_duplicate_repository {
	local first_seen_in
	local repository

	first_seen_in="${2}"
	repository="${1}"

	echo -e "${ORANGE}warning: ignoring duplicate repository '$(dirname -- "${repository}")' because it is already inside '${first_seen_in}'.${NOCOLOR}" >&2
	printed_warnings=yes
}

for path in "${directories[@]}"; do
	path_repositories=("${path}"/**/.git/)
	if [[ "${#path_repositories[@]}" -eq 0 ]]; then
		empty_paths+=("${path}")
		continue
	fi

	path_duplicate_repositories=()
	path_duplicate_sources=()

	for repository in "${path_repositories[@]}"; do
		if ! resolved_repository="$(realpath -- "${repository}")"; then
			echo -e "${RED}error: could not resolve the repository path '${repository}'.${NOCOLOR}" >&2
			exit 1
		fi
		if [[ -z "${included_repositories[${resolved_repository}]:-}" ]]; then
			included_repositories["${resolved_repository}"]="${path}"
			repositories+=("${repository}")
		else
			path_duplicate_repositories+=("${repository}")
			path_duplicate_sources+=("${included_repositories[${resolved_repository}]}")
		fi
	done

	if [[ "${#path_duplicate_repositories[@]}" -eq 0 ]]; then
		continue
	fi

	if [[ "${#path_duplicate_repositories[@]}" -eq "${#path_repositories[@]}" ]]; then
		# The path contributed nothing new: every repository it contains was
		# already covered by an earlier path. When all of them were covered by
		# the same path, a single warning about the path itself is enough.
		first_duplicate_source="${path_duplicate_sources[0]}"
		path_redundant_homogeneously=yes

		for duplicate_source in "${path_duplicate_sources[@]}"; do
			if [[ "${duplicate_source}" != "${first_duplicate_source}" ]]; then
				path_redundant_homogeneously=no
				break
			fi
		done

		if [[ "${path_redundant_homogeneously}" == yes ]]; then
			echo -e "${ORANGE}warning: ignoring repository entry '${path}' because it is already inside '${first_duplicate_source}'.${NOCOLOR}" >&2
			printed_warnings=yes
			continue
		fi
	fi

	for duplicate_index in "${!path_duplicate_repositories[@]}"; do
		warn_duplicate_repository "${path_duplicate_repositories[${duplicate_index}]}" "${path_duplicate_sources[${duplicate_index}]}"
	done
done

if [[ "${#repositories[@]}" -eq 0 ]]; then
	if [[ "${#directories[@]}" -eq 1 ]]; then
		echo -e "${RED}error: no .git directories found in '${directories[0]}'${NOCOLOR}" >&2
	else
		echo -e "${RED}error: no .git directories found in any of: ${directories[*]}${NOCOLOR}" >&2
	fi
	exit 1
fi

for empty_path in "${empty_paths[@]}"; do
	echo -e "${ORANGE}warning: no .git directories found in '${empty_path}'.${NOCOLOR}" >&2
	printed_warnings=yes
done

maximum_concurrent_syncs=5
total_syncs=${#repositories[@]}
completed_syncs=0
temporary_directory=$(mktemp -d "${TMPDIR:-/tmp}/gsync.XXXXXX") || {
	echo -e "${RED}error: could not create temporary directory.${NOCOLOR}" >&2
	exit 1
}
declare -a active_pids=()

function cleanup {
	[[ -n "${temporary_directory}" && -d "${temporary_directory}" ]] && rm -rf -- "${temporary_directory}"
}

trap cleanup EXIT HUP INT TERM

if [[ "${printed_warnings}" == yes && -t 1 ]]; then
	printf '\n' # separates the prepended warnings from the sync progress bar
fi

show_progress

for index in "${!repositories[@]}"; do
	repository="${repositories[${index}]}"
	while [[ "${#active_pids[@]}" -ge "${maximum_concurrent_syncs}" ]]; do
		wait_for_repository
	done

	(
		sync_repository "${repository}" "${temporary_directory}/${index}.status"
	) > "${temporary_directory}/${index}.stdout" 2> "${temporary_directory}/${index}.stderr" &
	active_pids+=("$!")
done

while [[ "${#active_pids[@]}" -gt 0 ]]; do
	wait_for_repository
done

if [[ -t 1 ]]; then
	printf '\n\n'
fi

for index in "${!repositories[@]}"; do
	cat "${temporary_directory}/${index}.stdout"
	cat "${temporary_directory}/${index}.stderr" >&2
done

updated_syncs=0
unchanged_syncs=0
skipped_syncs=0
failed_syncs=0

for index in "${!repositories[@]}"; do
	status_file="${temporary_directory}/${index}.status"
	if [[ -s "${status_file}" ]]; then
		repository_status=$(<"${status_file}")
	else
		repository_status=2 # counts a killed/interrupted synchronization as failed
	fi
	case "${repository_status}" in
		0) updated_syncs=$((updated_syncs + 1)) ;;
		1) unchanged_syncs=$((unchanged_syncs + 1)) ;;
		3) skipped_syncs=$((skipped_syncs + 1)) ;;
		*) failed_syncs=$((failed_syncs + 1)) ;;
	esac
done

if (( failed_syncs > 0 )); then
	summary_color="${RED}"
elif (( skipped_syncs > 0 )); then
	summary_color="${ORANGE}"
else
	summary_color="${GREEN}"
fi

noun="repositories"
if (( total_syncs == 1 )); then
	noun="repository"
fi

printf '\n'
echo -e "${summary_color}summary: ${total_syncs} ${noun} - ${updated_syncs} updated, ${unchanged_syncs} unchanged, ${skipped_syncs} skipped, ${failed_syncs} failed${NOCOLOR}"

if (( failed_syncs > 0 )); then
	exit 1
fi

if (( skipped_syncs > 0 )); then
	exit 2
fi

exit 0
